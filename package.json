{
  "name": "knowledge-island-learning",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tts:generate": "tsx scripts/generate-tts.ts",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:run": "vitest run",
    "curriculum:batch": "tsx --tsconfig tsconfig.app.json scripts/curriculum-batch.ts batch-01",
    "curriculum:import": "tsx --tsconfig tsconfig.app.json scripts/curriculum-batch.ts import",
    "curriculum:review": "tsx --tsconfig tsconfig.app.json scripts/curriculum-review.ts",
    "curriculum:data-review": "tsx --tsconfig tsconfig.app.json scripts/curriculum-data-review.ts",
    "curriculum:content:fetch": "tsx --tsconfig tsconfig.app.json scripts/curriculum-content-fetch.ts",
    "curriculum:content:discover": "tsx --tsconfig tsconfig.app.json scripts/curriculum-content-discover.ts",
    "curriculum:content:import-pdf": "tsx --tsconfig tsconfig.app.json scripts/curriculum-content-import-pdf.ts",
    "curriculum:validate": "npm run curriculum:review",
    "release:check": "tsx --tsconfig tsconfig.app.json scripts/mvp-release.ts",
    "server": "tsx --tsconfig tsconfig.app.json server/index.ts",
    "server:dev": "tsx --tsconfig tsconfig.app.json watch server/index.ts"
  },
  "dependencies": {
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.4.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.12"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
