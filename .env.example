VITE_APP_NAME=知识岛
VITE_API_BASE_URL=
VITE_USE_MOCK=true
# Development-only curriculum switches. Production builds always require REVIEWED data.
VITE_ALLOW_SAMPLE_CURRICULUM=true
VITE_ALLOW_UNREVIEWED_CURRICULUM=true

# PHASE 18: server-only. Copy to ignored .env.local, then restart npm run dev.
# Never use VITE_LLM_API_KEY: Vite publishes VITE_* in the browser.
LLM_PROVIDER=MOCK
LLM_BASE_URL=https://your-compatible-provider.example/v1
LLM_API_KEY=placeholder
LLM_MODEL=your-model-name
LLM_NATIVE_STRUCTURED_OUTPUT=true
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
# Optional, server-only; verified separately for ModelVerse deepseek-v4-flash-0731.
# Leave unset for providers that do not support the thinking parameter.
# LLM_THINKING_MODE=disabled

# PHASE 19.1: standalone local Learning Agent API.
AGENT_API_HOST=127.0.0.1
AGENT_API_PORT=8788
AGENT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional FastAPI gateway. Set AGENT_API_BACKEND=FASTAPI after installing requirements-fastapi.txt.
AGENT_API_BACKEND=NODE
FASTAPI_AGENT_HOST=127.0.0.1
FASTAPI_AGENT_PORT=8789
AGENT_UPSTREAM_URL=http://127.0.0.1:8788
# Optional local-only run metadata; disabled by default and stores no question text or prompts.
FASTAPI_AGENT_RUN_PERSISTENCE=false
FASTAPI_AGENT_RUN_DATABASE=.data/learning-agent.sqlite

# Authenticated formal AI practice, served by the family API in development AND production.
# Requires OPENAI_COMPATIBLE and real server-only credentials. Never expose a VITE_* key.
FORMAL_AI_ENABLED=false
# 反馈处理账号（先注册账号，再填写账号名；逗号分隔）。留空时无人拥有管理权限。
# 服务端配置，不要使用 VITE_ 前缀。处理反馈仍需输入密码完成家长操作确认。
FEEDBACK_ADMIN_ACCOUNTS=
